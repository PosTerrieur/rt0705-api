# Modèle du fichier .env de l'API : copier en .env
#   cp .env.exemple .env

# 1 = mode développement
FLASK_DEBUG=0

# Facultatif : mot de passe du compte « admin » créé au premier démarrage
# (sinon : docker compose run --rm api flask creer-admin)
ADMIN_MOT_DE_PASSE=

# Facultatif : clé TMDb pour préremplir les fiches
# themoviedb.org > Paramètres > API : « Clé d'API » ou « Jeton d'accès en lecture » (eyJ...)
TMDB_API_KEY=
